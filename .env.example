# Copy to .env (gitignored) and fill in your Supabase connection string.
#
# Supabase Dashboard -> Connect -> "Session pooler" (IPv4-friendly, supports the
# session-level features migrations need). Do NOT use the Transaction pooler (port 6543).
# Append ?sslmode=require to the end.
#
# Example shape (yours will differ):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

DATABASE_URL=

# dbmate reads DATABASE_URL above. Migrations live in db/migrations; schema snapshot in db/schema.sql.
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_SCHEMA_FILE=./db/schema.sql

# Bearer token for the human review server (python -m transitindex_ingest review).
# Required: the server refuses to start without it, since approving/editing writes
# straight into live metric_values. Use any long random string.
REVIEW_API_TOKEN=
