# Copy to .env.local (gitignored) and fill in.
#
# DATABASE_URL — the web app's RUNTIME connection. This MUST be a least-privilege
# login role (a member of web_reader): USAGE-not-CREATE on schemas core+app,
# SELECT-only on core, DML-only on app, owning no tables. With that, Postgres itself
# refuses any DDL — the read-only/introspect invariant is enforced by the database,
# not just by the absence of a migrate script.
#
# Do NOT put the dbmate/owner (schema-owning) credential here — that one lives in the
# repo-root .env and is only for db/migrations. The paywall is enforced in app code
# (a server-only choke point), because web_reader CAN SELECT raw core.metric_values.
#
# Supabase Dashboard -> Connect -> Session pooler (port 5432, IPv4-friendly), append
# ?sslmode=require. Example shape (yours will differ):
#   postgresql://<web_login>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Public site URL (used by sitemap.ts / robots.ts / canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth (sign-in). See web/SETUP-AUTH-BILLING.md for how to obtain each value. ---
# Secret that signs the session cookie. Generate one with:  npx auth secret
AUTH_SECRET=
# The app's base URL. Locally http://localhost:3000 ; in production your real domain.
AUTH_URL=http://localhost:3000
# Google sign-in — Google Cloud Console → Credentials → OAuth client (Web app).
# Authorized redirect URI must be:  <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link email — Resend dashboard → API Keys (starts with re_...).
AUTH_RESEND_KEY=
# The "from" address magic links are sent as. Must be on a Resend-verified domain;
# for first tests Resend's shared sender works (delivers only to your own account email).
AUTH_EMAIL_FROM=onboarding@resend.dev

# --- Stripe ($20/year membership). Use TEST-mode keys until you launch. ---
# Stripe dashboard → Developers → API keys → Secret key (sk_test_...).
STRIPE_SECRET_KEY=
# Webhook signing secret. Locally: `stripe listen` prints whsec_...; in prod, the
# Dashboard webhook endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=
# The recurring Price id (price_...) of your $20/year product.
STRIPE_PRICE_ID=
