# Copy to .env.local (gitignored) and fill in.
#
# DATABASE_URL — the web app's RUNTIME connection. This MUST be a least-privilege
# login role (a member of web_reader): USAGE-not-CREATE on schemas core+app,
# SELECT-only on core, DML-only on app, owning no tables. With that, Postgres itself
# refuses any DDL — the read-only/introspect invariant is enforced by the database,
# not just by the absence of a migrate script.
#
# Do NOT put the dbmate/owner (schema-owning) credential here — that one lives in the
# repo-root .env and is only for db/migrations. The paywall is enforced in app code
# (a server-only choke point), because web_reader CAN SELECT raw core.metric_values.
#
# Supabase Dashboard -> Connect -> Session pooler (port 5432, IPv4-friendly), append
# ?sslmode=require. Example shape (yours will differ):
#   postgresql://<web_login>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Public site URL (used by sitemap.ts / robots.ts / canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

