# Secrets — never commit the real connection string
.env
.env.local

# Node (web/, Lane B)
node_modules/
.next/
out/

# Python (ingest/, Lane A)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# dbmate local artifacts
/db/.dbmate/

# Real PDFs used for manual extractor smoke tests (large binaries; offline
# tests use synthetic PDFs, so these are never needed by CI).
ingest/tests/fixtures/real/

# Claude Code machine-local settings (per-user; shared config stays tracked)
.claude/settings.local.json

# Generated data workbooks (export-xlsx output; may hold real data — keep out of git)
transitindex-data*.xlsx
_roundtrip_smoke.xlsx
# Office temp/lock files (created when a workbook is open in Excel)
~$*

# OS / editor
.DS_Store
Thumbs.db
.gstack/
